{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "identifier": "dev.lumen.ui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "width": 1240,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMTE2NjJBNTVDMjMyN0UKUldSK01zSlZLbVlSTU8yYTdjcGY5a2lwVTNoaW1QZ0ZDejc1T3FkYUZBcU1CMGlPUDV3Uk93dEwK",
      "endpoints": ["https://github.com/karmanya007/Lumen/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
